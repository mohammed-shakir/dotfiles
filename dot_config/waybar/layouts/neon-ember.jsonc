{
	"layer": "top",
	"output": ["*"],
	"height": 10,
	"exclusive": true,
	"passthrough": false,
	"reload_style_on_change": true,
	"include": [
		"$XDG_CONFIG_HOME/waybar/modules/*json*",
		"$XDG_CONFIG_HOME/waybar/includes/includes.json"
	],
	"modules-left": ["group/pill#left1", "group/pill#left2"],
	"group/pill#left1": {
		"orientation": "inherit",
		"modules": ["hyprland/workspaces"]
	},
	"group/pill#left2": {
		"orientation": "inherit",
		"modules": ["custom/spotify", "custom/cava"]
	},
	"modules-center": ["group/pill#center"],
	"group/pill#center": {
		"modules": ["idle_inhibitor", "clock#center"],
		"orientation": "inherit"
	},
	"modules-right": ["group/pill#right1", "group/pill#right2"],
	"group/pill#right1": {
		"modules": ["cpu", "memory", "network"],
		"orientation": "inherit"
	},
	"group/pill#right2": {
		"modules": [
			"pulseaudio#microphone",
			"pulseaudio",
			"privacy",
			"custom/bluetooth",
			"tray",
			"battery",
			"custom/power"
		],
		"orientation": "inherit"
	}
}
